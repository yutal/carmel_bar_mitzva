*.pem
*.key

# Event data: guest submissions, photos of the celebrant, generated posters and songs
/data/
/data-*/
*.zip

# Personal media that must never be committed by accident
*.heic
*.HEIC
*.mp3
*.mov
*.MOV
*.mp4

# Testing and local scratch
/coverage
/test-results/
/playwright-report/
/.stage/
*.log

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

