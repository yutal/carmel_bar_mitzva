# Required: OpenAI API key (platform.openai.com, not the ChatGPT subscription)
OPENAI_API_KEY=
# Password for /admin (username: admin)
ADMIN_PASSWORD=
# Where all submission files are stored. Mount a persistent volume here in production.
DATA_DIR=./data
# Optional overrides
LLM_MODEL=gpt-5.5
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
GENERATION_CONCURRENCY=3
# Days to keep guests' original photos (posters are kept). 0 = keep forever
GUEST_PHOTO_RETENTION_DAYS=7
# Creations one guest (matched by name) may make. 0 = no limit
MAX_CREATIONS_PER_GUEST=3
# Video & voice lab: transcription model (needs segment timestamps) and clip length cap
TRANSCRIBE_MODEL=whisper-1
CLIP_MAX_SECONDS=30
# Set to 'mock' to run without API keys (fake text and images)
AI_PROVIDER=
